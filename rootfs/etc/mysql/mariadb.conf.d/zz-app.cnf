# Development settings. Buffer pool size and sql_mode are passed on the command line from
# DB_BUFFER_POOL / DB_SQL_MODE (see supervisor services.conf), so they can be changed via .env.
[mysqld]
bind-address           = 0.0.0.0
skip-name-resolve
character-set-server   = utf8mb4
collation-server       = utf8mb4_unicode_ci
max_connections        = 200
max_allowed_packet     = 256M
# Local data is disposable: trade durability for faster writes and imports.
innodb_flush_log_at_trx_commit = 2

slow_query_log         = 1
long_query_time        = 2

[client]
default-character-set  = utf8mb4

[mariadb-dump]
max_allowed_packet     = 1G
