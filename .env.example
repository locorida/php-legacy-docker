# Copy to .env and adjust. up.ps1 creates .env from this file on first run.
# Relative paths are resolved against the repository root.

# Name of the container; also the prefix for the image (<APP_NAME>:local) and the data volumes.
APP_NAME=php-legacy

# Host name(s) the mkcert certificate is issued for. *.localhost resolves to 127.0.0.1 in all
# major browsers, so no hosts-file entry is needed.
APP_DOMAIN=app.localhost

# Your code. Mounted at /var/www/html; nginx serves DOCUMENT_ROOT (container path).
PROJECTS_DIR=./app
DOCUMENT_ROOT=/var/www/html/public

# Writable app data (uploads, generated files). Mounted at /srv/data. Leave empty to skip.
DATA_DIR=./data

# Ports on the Windows host (bound to 127.0.0.1 only).
HTTP_PORT=8080
HTTPS_PORT=8443
DB_PORT=3306
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# Database created on first start (empty data volume). Local development only.
DB_NAME=app
DB_USER=app
DB_PASSWORD=app
DB_BUFFER_POOL=256M
# Many legacy apps predate strict mode. Use STRICT_TRANS_TABLES,... once your code is ready.
DB_SQL_MODE=NO_ENGINE_SUBSTITUTION

# PHP base image. Empty = default from the Dockerfile (PHP 8.5). Change, then: up.ps1 -Rebuild
# Example: PHP_IMAGE=php:8.4-fpm-trixie
PHP_IMAGE=

TZ=UTC

# off | debug | develop | coverage
XDEBUG_MODE=off

# 1 = PHP checks files for changes (simple, slower on Windows bind mounts)
# 0 = fast; run up.ps1 -Watch so PHP-FPM is reloaded on every change
OPCACHE_VALIDATE_TIMESTAMPS=1

# Optional long-running worker, started by supervisord as www-data once the DB is up.
# Example: WORKER_COMMAND=php /var/www/html/bin/worker.php
WORKER_COMMAND=
